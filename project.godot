; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Century City"
run/main_scene="uid://jsnesmd30dqv"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ControllerIcons="*uid://bjxviqoil0hkw"
GameState="*uid://c021lnpkanwdr"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

script/templates_search_path="res://content/script_templates"
version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/controller_icons/plugin.cfg", "res://addons/widget_component/plugin.cfg")

[global_group]

Player=""
Enemy=""
Map=""
Solid=""

